{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SafetySignalAssessment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "issue": {"type": "string"},
    "scope": {"enum": ["exact_device", "product_family", "device_class", "mixed"]},
    "supporting_record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "severity_evidence": {"type": "string"},
    "recurrence_evidence": {"type": "string"},
    "recency_evidence": {"type": "string"},
    "cross_source_support": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "assessment": {"enum": ["established/publicly documented issue", "recurrent reported issue", "potential signal requiring further assessment", "isolated report", "insufficient public evidence"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["issue", "scope", "supporting_record_ids", "severity_evidence", "recurrence_evidence", "recency_evidence", "cross_source_support", "assessment", "limitations"]
}
